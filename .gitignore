# MkDocs build output — generated, never committed.
site/

# Rust build output.
target/
**/*.rs.bk
*.pdb

# The Cargo manifest an IDE needs before it will read this library's Rust, and
# the config beside it, both written per machine by tools/write_cargo_toml.py.
# The examples are compiled by bare rustc (tools/run_examples.py), so none of
# this is the build; what Cargo builds from it lands in the target/ above.
/Cargo.toml
/Cargo.lock
/.cargo

# JetBrains IDEs (RustRover / PyCharm) — per-machine project config, and where
# the manifest above is remembered once it has been attached.
.idea/

# Compiled example binaries (the .rs source and its .out answer key are what we keep).
/tmp_examples/

# Python
.venv
__pycache__/
*.pyc

# macOS
.DS_Store

# Anki deck build scratch (verify.py compiles every card snippet through these).
10_Resources/anki/snippets/
10_Resources/anki/bin/
10_Resources/anki/out/
